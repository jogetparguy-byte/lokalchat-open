# LokalChat Open — placeholders sahaja; salin ke .env dan isi projek staging.
# REQUIRED = aplikasi berfungsi; CONDITIONAL = diperlukan oleh fungsi berkenaan.
# OPTIONAL = boleh dibiarkan kosong/commented. Jangan commit .env sebenar.
# Semua VITE_* adalah PUBLIC dan dibundel semasa build. Jangan letak secret di sini.

# REQUIRED | CLIENT-SIDE | Supabase projek yang sama dengan server
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLIC_PUBLISHABLE_KEY

# REQUIRED | SERVER-ONLY runtime | URL/public key bukan secret, service key ialah secret
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_SERVICE_ROLE_KEY

# CONDITIONAL | SERVER-ONLY secret | WhatsApp DAN kunci AI tersimpan dalam admin
# Jana secret rawak sendiri (contoh: openssl rand -hex 32). Kekalkan nilainya;
# menukar/membuangnya menyebabkan credentials DB sedia ada gagal didecrypt.
# Kosong sehingga fungsi diperlukan; jangan gunakan placeholder sebagai encryption key.
WHATSAPP_CRYPTO_KEY=

# OPTIONAL | SERVER-ONLY | default kod; semak sokongan versi Meta sebelum production
# WHATSAPP_GRAPH_VERSION=v21.0

# CONDITIONAL | SERVER-ONLY | ketiga-tiga wajib jika tiada kunci AI aktif yang
# boleh didecrypt dalam platform_api_keys. Biarkan kosong untuk setup tanpa AI.
# Isi API key sendiri, endpoint OpenAI-compatible dan model yang disokong provider.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# OPTIONAL | SERVER-ONLY | override metadata provider bagi kunci AI dalam admin
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# OPTIONAL | SERVER-ONLY secret | embedding text-embedding-3-small (1536 dimensi)
# Tanpa key/embedding gagal, carian menggunakan keyword fallback.
OPENAI_API_KEY=

# OPTIONAL | SERVER/TOOLING | production Nitro; pnpm dev tetap 127.0.0.1:3000
# PORT=3000
# HOST=127.0.0.1

# OPTIONAL | TOOLING-ONLY | export sebelum pnpm dev untuk memilih fail env lain
# LOKALCHAT_ENV_FILE=/absolute/path/to/staging.env

# OPTIONAL | TEST-ONLY | tiada diperlukan untuk unit tests biasa
# APP_URL=http://127.0.0.1:3000/auth
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
# STAGING_ENV_FILE=/absolute/path/to/staging.env
# STAGING_APP_URL=http://127.0.0.1:3000
# STAGING_SCREENSHOT_PATH=/tmp/lokalchat-staging-browser-failure.png

# OPTIONAL | TEST-ONLY legacy aliases; bukan konfigurasi login aplikasi.
# Hanya fallback test:staging:rls jika publishable key tiada. Utamakan nama di atas.
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON_KEY=

# BUKAN ENV: WhatsApp access token, phone number ID, app secret dan verify token
# dikonfigurasi melalui Settings dan disimpan dalam whatsapp_connections.
# Kunci Gemini/DeepSeek admin disimpan dalam platform_api_keys, bukan *_API_KEY env.
# Token cron weekly_report_token berada dalam public.internal_settings
# (service_role sahaja); scheduler membacanya pada runtime. Jangan tambah ke .env.
